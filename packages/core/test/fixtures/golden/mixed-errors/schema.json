{
  "name": "Orders",
  "columns": [
    { "name": "id", "type": "integer", "required": true, "unique": true },
    { "name": "email", "type": "email", "required": true },
    { "name": "code", "type": "string", "pattern": "[A-Z]{3}" },
    { "name": "placed", "type": "date", "dateFormat": "MM/DD/YYYY", "min": "2020-01-01" },
    { "name": "qty", "type": "integer", "min": 1, "max": 100 },
    { "name": "currency", "type": "string", "enum": ["USD", "EUR"] },
    { "name": "paid", "type": "boolean" }
  ]
}
